# ───────── База данных ─────────
# DATABASE_DATABASE — да, имя переменной такое: pydantic-settings склеивает
# имя секции (database) и имя поля (database) через "_".
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DATABASE=metrica
DATABASE_USER=metrica
DATABASE_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
DATABASE_ECHO=false

# ───────── Приложение ─────────
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# Составные имена (APP_CORS_ORIGINS) pydantic-settings не парсит через env —
# фактически не используется, фронт и API живут на одном домене через nginx.
APP_CORS_ORIGINS=https://metrica-platform.ru,http://localhost:5173

# ───────── Секреты ─────────
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИ_openssl_rand_hex_32
JWT_SECRET_KEY=ЗАМЕНИ_openssl_rand_hex_32_МИНИМУМ_32_СИМВОЛА

# ───────── OAuth: Yandex ─────────
# Redirect URI должен указывать на ПУБЛИЧНЫЙ адрес сервера (домен/IP),
# путь идёт через nginx-прокси /api/ -> бэкенд.
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
AUTH_YANDEX_REDIRECT_URI=https://ЗАМЕНИ_ДОМЕН_ИЛИ_IP/api/auth/oauth/yandex/callback
AUTH_YANDEX_SCOPE=

# ───────── Telegram-логин ─────────
AUTH_TELEGRAM_BOT_TOKEN=
AUTH_TELEGRAM_BOT_USERNAME=

# ───────── Начальный админ ─────────
ADMIN_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ

# ───────── Логи ─────────
LOGGING_LEVEL=INFO
LOGGING_FOLDER=/app/logs
