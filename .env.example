# ───────── База данных ─────────
# DATABASE_DATABASE — да, имя переменной такое: pydantic-settings склеивает
# имя секции (database) и имя поля (database) через "_".
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DATABASE=metrica
DATABASE_USER=metrica
DATABASE_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
DATABASE_ECHO=false

# ───────── Приложение ─────────
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# Составные имена (APP_CORS_ORIGINS) pydantic-settings не парсит через env —
# фактически не используется, фронт и API живут на одном домене через nginx.
APP_CORS_ORIGINS=https://metrica-platform.ru,http://localhost:5173

# ───────── Секреты ─────────
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИ_openssl_rand_hex_32
JWT_SECRET_KEY=ЗАМЕНИ_openssl_rand_hex_32_МИНИМУМ_32_СИМВОЛА

# ───────── Куки ─────────
# В production по умолчанию куки ставятся с флагом Secure (нужен HTTPS).
# Пока сайт живёт на голом HTTP (нет домена/сертификата) — держи false,
# иначе браузер тихо не сохранит access/refresh куки после логина.
# Как только настроишь certbot — удали эту строку или поставь true.
AUTH_COOKIE_SECURE=false

# ───────── OAuth: Yandex ─────────
# Redirect URI должен указывать на ПУБЛИЧНЫЙ адрес сервера (домен/IP),
# путь идёт через nginx-прокси /api/ -> бэкенд.
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
AUTH_YANDEX_REDIRECT_URI=https://ЗАМЕНИ_ДОМЕН_ИЛИ_IP/api/auth/oauth/yandex/callback
AUTH_YANDEX_SCOPE=

# ───────── Telegram-логин ─────────
AUTH_TELEGRAM_BOT_TOKEN=
AUTH_TELEGRAM_BOT_USERNAME=

# ───────── Исходящий прокси ─────────
# Если серверу нужен прокси для исходящих запросов к AI/OAuth/Telegram:
# OUTBOUND_PROXY_URL=http://user:password@proxy-host:proxy-port
# SOCKS-прокси потребует httpx[socks] в зависимостях.
OUTBOUND_PROXY_URL=

# ───────── Почта (подтверждение регистрации, приглашения) ─────────
# Свой ящик Яндекса/mail.ru + пароль приложения (НЕ обычный пароль от почты!):
#   Яндекс: id.yandex.ru -> Пароли и авторизация -> Пароли приложений
#   mail.ru: аналогично в настройках безопасности аккаунта
# Если оставить пустым — письма просто не отправляются (логируется предупреждение),
# остальной функционал не ломается.
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=ЗАМЕНИ_НА_ПОЧТУ@yandex.ru
EMAIL_SMTP_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ_ПРИЛОЖЕНИЯ
EMAIL_SMTP_FROM=ЗАМЕНИ_НА_ПОЧТУ@yandex.ru
EMAIL_SMTP_USE_SSL=true
# Публичный адрес фронтенда — используется для ссылок в письмах
EMAIL_FRONTEND_BASE_URL=http://176.108.247.183

# ───────── Начальный админ ─────────
ADMIN_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ

# ───────── Логи ─────────
LOGGING_LEVEL=INFO
LOGGING_FOLDER=/app/logs
